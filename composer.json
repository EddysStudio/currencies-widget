{
    "name": "eddysstudio/currencies-widget",
    "description": "This is my package currencies-widget",
    "keywords": [
        "EddysStudio",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "currencies-widget"
    ],
    "homepage": "https://github.com/EddysStudio/currencies-widget",
    "support": {
        "issues": "https://github.com/EddysStudio/currencies-widget/issues",
        "source": "https://github.com/EddysStudio/currencies-widget"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "EddySun",
            "email": "fred198094@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "EddysStudio\\CurrenciesWidget\\": "src/",
            "EddysStudio\\CurrenciesWidget\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EddysStudio\\CurrenciesWidget\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "EddysStudio\\CurrenciesWidget\\CurrenciesWidgetServiceProvider"
            ],
            "aliases": {
                "CurrenciesWidget": "EddysStudio\\CurrenciesWidget\\Facades\\CurrenciesWidget"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
